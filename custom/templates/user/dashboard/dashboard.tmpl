{{/* Overrides Forgejo's dashboard. Identical to upstream except for the
     program strip below the navbar: a signed-in user never sees the landing
     page again, so without this the funded repositories and the contributor
     path vanish the moment their feed has anything in it. Kept to one compact
     row so it informs without competing with the feed. Styles are scoped and
     use theme tokens, so both Eliza themes follow. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds">
	{{template "user/dashboard/navbar" .}}
	<div class="ui container">
		<style>
			.eliza-strip {
				align-items: center;
				border: 1px solid var(--color-border);
				border-radius: 6px;
				display: flex;
				flex-wrap: wrap;
				gap: 10px 18px;
				margin-bottom: 14px;
				padding: 10px 14px;
			}
			.eliza-strip-label {
				color: var(--color-primary);
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.eliza-strip a.eliza-strip-repo {
				color: var(--color-text);
				font-family: var(--fonts-monospace);
				font-size: 13px;
				text-decoration: none;
			}
			.eliza-strip a.eliza-strip-repo:hover {
				color: var(--color-primary);
			}
			.eliza-strip-sep {
				color: var(--color-text-light-3);
			}
			.eliza-strip-mission {
				color: var(--color-text-light-2);
				font-size: 12.5px;
				margin-left: auto;
			}
			.eliza-strip-mission a {
				color: var(--color-primary);
			}
			@media (max-width: 767px) {
				.eliza-strip-mission { margin-left: 0; }
			}
		</style>
		<div class="eliza-strip">
			<span class="eliza-strip-label">Eliza Army funded</span>
			<a class="eliza-strip-repo" href="{{AppSubUrl}}/elizaOS/eliza">elizaOS/eliza</a>
			<span class="eliza-strip-sep">&middot;</span>
			<a class="eliza-strip-repo" href="{{AppSubUrl}}/elizaOS/arklib">elizaOS/arklib</a>
			<span class="eliza-strip-mission">
				Accepted work earns from the $10,000 monthly pool &mdash;
				<a href="https://eliza.army" target="_blank" rel="noopener noreferrer">how it works</a>
			</span>
		</div>
	</div>
	<div class="ui container flex-container">
		<div class="flex-container-main">
			{{template "base/alert" .}}
			{{template "user/heatmap" .}}
			{{if .Feeds}}
				{{template "user/dashboard/feeds" .}}
			{{else}}
				{{template "user/dashboard/guide" .}}
			{{end}}
		</div>
		{{template "user/dashboard/repolist" .}}
	</div>
</div>
{{template "base/footer" .}}
