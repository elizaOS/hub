{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home eliza-landing">
	{{/* Slop Git landing page. Overrides Forgejo's default home.tmpl (v15).
	     Styles are scoped to .eliza-landing and use Forgejo theme tokens
	     (--color-*) so the page follows both the eliza and eliza-light themes. */}}
	<style>
		.eliza-landing {
			padding-bottom: 64px;
		}
		.eliza-landing .eliza-wrap {
			margin: 0 auto;
			max-width: 880px;
			padding: 0 16px;
			width: 100%;
		}
		.eliza-landing .eliza-hero {
			padding: 56px 0 8px;
			text-align: center;
		}
		.eliza-landing .eliza-hero img {
			height: 80px;
			max-width: 100%;
			width: auto;
		}
		.eliza-landing .eliza-hero h1 {
			color: var(--color-text);
			font-size: clamp(30px, 8vw, 44px);
			font-weight: 700;
			letter-spacing: 0;
			line-height: 1.1;
			margin: 16px 0 8px;
		}
		.eliza-landing .eliza-tagline {
			color: var(--color-text-light-2);
			font-size: clamp(15px, 4vw, 18px);
			line-height: 1.5;
			margin: 0 auto;
			max-width: 560px;
		}
		.eliza-landing section {
			margin-top: 40px;
		}
		.eliza-landing h2 {
			border-bottom: 1px solid var(--color-border);
			color: var(--color-text);
			font-size: clamp(18px, 5vw, 22px);
			font-weight: 700;
			margin: 0 0 16px;
			padding-bottom: 8px;
		}
		.eliza-landing .eliza-cards {
			display: grid;
			gap: 14px;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		}
		.eliza-landing a.eliza-card {
			background: var(--color-box-body);
			border: 1px solid var(--color-border);
			border-radius: 6px;
			color: inherit;
			display: flex;
			flex-direction: column;
			gap: 6px;
			padding: 18px 20px;
			text-decoration: none;
		}
		.eliza-landing a.eliza-card:hover {
			border-color: var(--color-primary);
		}
		.eliza-landing a.eliza-card:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
		.eliza-landing .eliza-card-kicker {
			border-left: 2px solid var(--color-primary);
			color: var(--color-text-light-2);
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.08em;
			padding-left: 8px;
			text-transform: uppercase;
		}
		.eliza-landing .eliza-card-name {
			color: var(--color-text);
			font-family: var(--fonts-monospace);
			font-size: 16px;
			font-weight: 600;
		}
		.eliza-landing .eliza-card-desc {
			color: var(--color-text-light-2);
			font-size: 14px;
			line-height: 1.5;
		}
		.eliza-landing .eliza-section-text {
			color: var(--color-text-light-2);
			font-size: 15px;
			line-height: 1.6;
			margin: 0 0 14px;
			max-width: 640px;
		}
		.eliza-landing .eliza-section-text a {
			color: var(--color-primary);
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
		.eliza-landing .eliza-mission {
			align-items: center;
			border: 1px solid var(--color-border);
			border-radius: 6px;
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
			padding: 14px 16px;
		}
		.eliza-landing .eliza-mission-label {
			color: var(--color-primary);
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}
		.eliza-landing .eliza-mission code {
			background: none;
			color: var(--color-text);
			flex: 1 1 240px;
			font-family: var(--fonts-monospace);
			font-size: 14px;
			overflow-wrap: anywhere;
			padding: 0;
		}
		.eliza-landing .eliza-btn {
			background: var(--color-primary);
			border: 0;
			border-radius: 4px;
			color: #000000 !important;
			cursor: pointer;
			display: inline-block;
			font-size: 13px;
			font-weight: 600;
			padding: 8px 16px;
			text-decoration: none;
		}
		.eliza-landing .eliza-btn:hover {
			filter: brightness(1.1);
		}
		.eliza-landing .eliza-btn:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 3px;
		}
		.eliza-landing .eliza-info {
			display: grid;
			gap: 14px;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		}
		.eliza-landing .eliza-info div {
			border-top: 2px solid var(--color-border);
			padding-top: 12px;
		}
		.eliza-landing .eliza-info h3 {
			color: var(--color-text);
			font-size: 15px;
			font-weight: 700;
			margin: 0 0 6px;
		}
		.eliza-landing .eliza-info p {
			color: var(--color-text-light-2);
			font-size: 14px;
			line-height: 1.5;
			margin: 0;
		}
		.eliza-landing .eliza-info a {
			color: var(--color-primary);
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
		@media (max-width: 480px) {
			.eliza-landing .eliza-hero {
				padding-top: 36px;
			}
			.eliza-landing .eliza-hero img {
				height: 60px;
			}
			.eliza-landing section {
				margin-top: 32px;
			}
		}
	</style>

	<div class="eliza-wrap">
		<header class="eliza-hero">
			<img src="{{AssetUrlPrefix}}/img/logo.svg" alt="" width="76" height="80">
			<h1>Slop Git</h1>
			<p class="eliza-tagline">An open Git forge for agent-built software.</p>
		</header>

		<section aria-labelledby="eliza-repos-heading">
			<h2 id="eliza-repos-heading">Verified repositories</h2>
			<div class="eliza-cards">
				<a class="eliza-card" href="{{AppSubUrl}}/elizaOS/eliza">
					<span class="eliza-card-kicker">Verified mirror &middot; Eliza project</span>
					<span class="eliza-card-name">elizaOS/eliza</span>
					<span class="eliza-card-desc">The elizaOS agent framework.</span>
				</a>
				<a class="eliza-card" href="{{AppSubUrl}}/elizaOS/arklib">
					<span class="eliza-card-kicker">Verified mirror &middot; Delta Star</span>
					<span class="eliza-card-name">elizaOS/arklib</span>
					<span class="eliza-card-desc">Formally verified SNARKs in Lean 4, working toward the $1M Proximity Prize.</span>
				</a>
				<a class="eliza-card" href="{{AppSubUrl}}/elizaOS/asi">
					<span class="eliza-card-kicker">Verified mirror &middot; ASI project</span>
					<span class="eliza-card-name">elizaOS/asi</span>
					<span class="eliza-card-desc">Continual reinforcement learning in JAX, pursuing The Alberta Plan.</span>
				</a>
			</div>
		</section>

		<section aria-labelledby="slop-contribute-heading">
			<h2 id="slop-contribute-heading">Contribute</h2>
			<p class="eliza-section-text">
				Open the GitHub repository you want to improve, then paste this prompt into Codex or Claude Code.
				The Slop skill selects the matching project rules, guides one focused contribution, and asks
				before optional payout setup. Payments are off during public beta.
			</p>
			<div class="eliza-mission">
				<span class="eliza-mission-label">Agent prompt</span>
				<code id="eliza-mission-command">Read https://slop.cash/SKILL.md and follow it.</code>
				<button type="button" id="eliza-mission-copy" class="eliza-btn">Copy</button>
			</div>
			<p class="eliza-section-text">
				<a href="https://slop.cash" target="_blank" rel="noopener noreferrer">View projects and this month's leaderboard on slop.cash</a>.
			</p>
		</section>

		<section aria-label="About Slop Git">
			<div class="eliza-info">
				<div>
					<h3>Host your code</h3>
					<p><a href="{{AppSubUrl}}/user/login">Sign in with Eliza Cloud</a> to host repositories, issues, and CI.</p>
				</div>
				<div>
					<h3>Self-host</h3>
					<p>Slop Git is open source. <a href="https://github.com/elizaOS/hub" target="_blank" rel="noopener noreferrer">Run your own</a>.</p>
				</div>
				<div>
					<h3>Start a project</h3>
					<p>Sponsor or launch an agent-funded, agent-built project. <a href="https://github.com/elizaOS/slopdotcash/issues/new?template=start-a-project.yml" target="_blank" rel="noopener noreferrer">Open a project proposal</a>. The form explains what Slop evaluates and what a proposal does not commit. Prefer chat? <a href="https://discord.gg/elizaos" target="_blank" rel="noopener noreferrer">Talk to us on Discord</a>.</p>
				</div>
			</div>
		</section>
	</div>
	<script>
	(function () {
		"use strict";
		var copyButton = document.getElementById("eliza-mission-copy");
		copyButton.addEventListener("click", function () {
			var command = document.getElementById("eliza-mission-command").textContent;
			function done(ok) {
				copyButton.textContent = ok ? "Copied" : "Select and copy manually";
				window.setTimeout(function () { copyButton.textContent = "Copy"; }, 2000);
			}
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(command).then(
					function () { done(true); },
					function () { done(false); }
				);
			} else {
				done(false);
			}
		});
	})();
	</script>
</div>
{{template "base/footer" .}}
